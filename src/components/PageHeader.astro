---
/**
 * The band at the top of an interior page: breadcrumb, title, optional lede.
 * Keeps every non-home page opening the same way.
 */
interface Props {
  title: string;
  lede?: string | null;
  eyebrow?: string | null;
  breadcrumb?: Array<{ label: string; href: string }>;
}

const { title, lede = null, eyebrow = null, breadcrumb = [] } = Astro.props;
---

<div class="page-header">
  <div class="wrap">
    {breadcrumb.length > 0 && (
      <nav class="crumbs small" aria-label="Breadcrumb">
        <ol class="list-plain">
          {breadcrumb.map((crumb) => (
            <li><a href={crumb.href}>{crumb.label}</a></li>
          ))}
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
    )}
    {/* The breadcrumb already names the conference, so the eyebrow would
        simply repeat it. */}
    {eyebrow && breadcrumb.length === 0 && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
</div>

<style>
  .page-header {
    padding-block: var(--s-6) var(--s-5);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(48rem 14rem at 8% -60%, var(--accent-wash), transparent 70%),
      var(--paper);
  }
  .page-header h1 { font-size: var(--step-3); margin-top: var(--s-2); }
  .page-header .lede { margin-top: var(--s-4); }

  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--s-2); color: var(--ink-3); }
  .crumbs li + li::before { content: '/'; margin-right: var(--s-2); color: var(--line-strong); }
  .crumbs a { color: var(--ink-3); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); text-decoration: underline; }
</style>
