---
/**
 * The ISPASS logo, inlined so it follows the theme.
 *
 * Same geometry as public/brand/ispass-logo.svg — the staircase of bars and the
 * ISPASS wordmark. Inlined rather than referenced with <img> because an <img>
 * cannot read CSS custom properties, so it could not switch colours in dark
 * mode. Colours come from --logo-word and --logo-bars in tokens.css.
 *
 * The wordmark is outlined from Archivo Black (SIL Open Font License 1.1; see
 * public/brand/README.md), so the logo renders identically everywhere and
 * needs no font download.
 *
 * To change the logo, regenerate the SVGs in public/brand/ and paste the new
 * path data here. Do not edit the paths by hand.
 */
interface Props {
  /** Rendered height in CSS units. Width follows the aspect ratio. */
  height?: string;
  /**
   * Accessible name. Pass an empty string when the logo sits inside a link or
   * heading that already names it, so screen readers do not say it twice.
   */
  label?: string;
  class?: string;
}

const { height = '2rem', label = 'ISPASS', class: className } = Astro.props;
const decorative = label === '';
---

<svg
  class:list={['logo', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="-4 -6.00 801.41 197.00"
  style={`height: ${height}`}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : label}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
>
