<style>
  .logo {
    display: block;
    width: auto;
    flex: none;
  }
  .logo-bars { fill: var(--logo-bars); }
  .logo-word { fill: var(--logo-word); }

  /* One colour in print, so it reproduces on any printer. */
  @media print {
    .logo-bars, .logo-word { fill: #000; }
  }
</style>
