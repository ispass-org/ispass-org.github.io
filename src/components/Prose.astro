---
/**
 * Typographic wrapper for rendered Markdown.
 *
 * All long-form styling lives here rather than in global.css, so that the
 * generous vertical rhythm and constrained measure apply only where prose is
 * actually rendered — and never leak into the schedule or the card grids.
 */
---

<div class="prose">
  <slot />
</div>

<style is:global>
  .prose {
    max-width: var(--measure);
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--ink-2);
  }

  .prose > * + * { margin-top: var(--s-4); }

  .prose h2 {
    font-size: var(--step-2);
    margin-top: var(--s-7);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .prose h3 {
    font-size: var(--step-1);
    margin-top: var(--s-6);
    color: var(--ink);
  }
  .prose h4 {
    font-family: var(--font-text);
    font-size: var(--step-0);
    font-weight: 700;
    margin-top: var(--s-5);
    color: var(--ink);
  }
  .prose h2 + *, .prose h3 + *, .prose h4 + * { margin-top: var(--s-3); }

  .prose ul, .prose ol { padding-left: 1.35em; }
  .prose li + li { margin-top: var(--s-2); }
  .prose li > ul, .prose li > ol { margin-top: var(--s-2); }

  .prose blockquote {
    border-left: 3px solid var(--line-strong);
    padding-left: var(--s-4);
    color: var(--ink-3);
    font-style: italic;
  }

  /* Tables inside prose can exceed the measure; give them room to scroll. */
  .prose table { display: block; overflow-x: auto; max-width: 100%; }
  @supports (width: max-content) {
    .prose table { display: table; }
  }

  /* An external link in body copy reads as a link, not as a button — except
     where a page marks it as an action. */
  .prose a[href^='http']::after {
    content: '↗';
    font-size: 0.75em;
    vertical-align: 0.35em;
    margin-left: 0.15em;
    opacity: 0.6;
  }

  /* Headings get a quiet anchor affordance on hover, for deep links. */
  .prose :is(h2, h3) > a.anchor {
    opacity: 0;
    margin-left: 0.3em;
    text-decoration: none;
    color: var(--ink-faint);
  }
  .prose :is(h2, h3):hover > a.anchor,
  .prose a.anchor:focus-visible { opacity: 1; }
</style>
