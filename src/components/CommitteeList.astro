---
/**
 * Organizing committee, rendered from committee.yaml.
 *
 * A role with no confirmed people is shown as "To be announced" rather than
 * omitted: early in the cycle, the shape of the committee is itself useful
 * information, and an empty slot is a visible prompt for the Web Chair.
 */
import type { Committee, Person } from '../lib/schema';

interface Props {
  committee: Committee;
  /**
   * Heading level for the role names. The committee page puts this component
   * directly under its <h1>, so the roles are h2 there; embed it under a
   * section heading and pass 3.
   */
  headingLevel?: 2 | 3;
}

const { committee, headingLevel = 2 } = Astro.props;
const RoleHeading = `h${headingLevel}` as 'h2' | 'h3';
const GroupHeading = `h${headingLevel}` as 'h2' | 'h3';
const SubHeading = `h${headingLevel + 1}` as 'h3' | 'h4';

const roles = committee.roles
  .slice()
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

/** Group the PC by surname initial, which is how people scan a long list. */
function groupByInitial(people: Person[]) {
  const sorted = people
    .slice()
    .sort((a, b) => a.name.localeCompare(b.name, 'en'));
  const groups = new Map<string, Person[]>();
  for (const person of sorted) {
    const initial = person.name.trim()[0]?.toUpperCase() ?? '?';
    const bucket = groups.get(initial) ?? [];
    bucket.push(person);
    groups.set(initial, bucket);
  }
  return [...groups.entries()];
}

const pcGroups = groupByInitial(committee.program_committee);
---

<div class="committee">
  <ul class="list-plain roles">
    {roles.map((role) => (
      <li class:list={['role', role.people.length === 0 && 'is-empty']}>
        <RoleHeading class="role-name">{role.role}</RoleHeading>
        {role.people.length === 0 ? (
          <p class="tbd">To be announced</p>
        ) : (
          <ul class="list-plain people">
            {role.people.map((person) => (
              <li class="person">
                <span class="person-name">
                  {person.url ? (
                    <a href={person.url} rel="noopener">{person.name}</a>
                  ) : (
                    person.name
                  )}
                </span>
                {person.affiliation && <span class="person-aff">{person.affiliation}</span>}
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>

  {committee.extra_groups.map((group) => (
    <section class="extra-group">
      <GroupHeading>{group.title}</GroupHeading>
      {group.description && <p class="muted">{group.description}</p>}
      <ul class="list-plain people people-wide">
        {group.people.map((person) => (
          <li class="person">
            <span class="person-name">{person.name}</span>
            {person.affiliation && <span class="person-aff">{person.affiliation}</span>}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="pc">
    <div class="section-head">
      <GroupHeading>Program Committee</GroupHeading>
    </div>
    {pcGroups.length === 0 ? (
      <p class="tbd">
        The ISPASS program committee is assembled by the Program Chair and will be
        listed here once it is complete.
      </p>
    ) : (
      <div class="pc-groups">
        {pcGroups.map(([initial, people]) => (
          <div class="pc-group">
            <SubHeading class="pc-initial" aria-hidden="true">{initial}</SubHeading>
            <ul class="list-plain">
              {people.map((person) => (
                <li class="person">
                  <span class="person-name">{person.name}</span>
                  {person.affiliation && <span class="person-aff">{person.affiliation}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
  </section>
</div>

<style>
  .roles {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
  }

  .role {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--s-4) var(--s-5);
    background: var(--paper);
  }
  .role.is-empty { background: var(--surface); border-style: dashed; }

  .role-name {
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--s-3);
  }

  .people li + li { margin-top: var(--s-3); }

  .person-name {
    display: block;
    font-weight: 600;
    color: var(--ink);
  }
  .person-name a { color: inherit; text-decoration: none; }
  .person-name a:hover { color: var(--accent); text-decoration: underline; }
  .person-aff {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .extra-group, .pc { margin-top: var(--s-8); }

  .pc-groups {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
  }
  .pc-group ul li + li { margin-top: var(--s-2); }
  .pc-initial {
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent);
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--s-1);
    margin-bottom: var(--s-3);
  }
  .pc .person-name { font-weight: 500; }

  .people-wide {
    display: grid;
    gap: var(--s-3);
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    margin-top: var(--s-4);
  }
</style>
