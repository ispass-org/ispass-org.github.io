---
import type { GetStaticPaths } from 'astro';
import ConferenceLayout from '../../layouts/ConferenceLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CommitteeList from '../../components/CommitteeList.astro';
import { conferenceYears, loadConference } from '../../lib/conferences';

export const getStaticPaths = (() =>
  conferenceYears().map((year) => ({ params: { year: String(year) } }))) satisfies GetStaticPaths;

const year = Number(Astro.params.year);
const c = loadConference(year);

const confirmed = c.committee.roles.filter((role) => role.people.length > 0).length;
const total = c.committee.roles.length;
---

<ConferenceLayout
  conference={c}
  title="Committee"
  description={`The organizing and program committee of ${c.conference.short_name}.`}
>
  <PageHeader
    title="Committee"
    eyebrow={c.conference.short_name}
    lede="The people organizing this edition of ISPASS."
    breadcrumb={[{ label: c.conference.short_name, href: `/${year}/` }]}
  />

  <div class="wrap section">
    {confirmed < total && (
      <aside class="callout callout-tbd">
        <b class="callout-title">Committee forming</b>
        <p>
          {confirmed} of {total} roles have been confirmed. Remaining roles are marked
          "to be announced" and will be filled in as appointments are made.
        </p>
      </aside>
    )}

    <CommitteeList committee={c.committee} />

    <p class="contact-note small muted">
      Contact details are not published on this page. Questions about a specific
      area should go to the relevant chair; see the
      <a href={`/${year}/policies/`}>conference policies</a> for how to report a
      problem.
    </p>
  </div>
</ConferenceLayout>

<style>
  .contact-note { margin-top: var(--s-7); max-width: var(--measure); }
</style>
