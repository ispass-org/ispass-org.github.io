---
import type { GetStaticPaths } from 'astro';
import ConferenceLayout from '../../layouts/ConferenceLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import KeynoteCard from '../../components/KeynoteCard.astro';
import { conferenceYears, loadConference } from '../../lib/conferences';

export const getStaticPaths = (() =>
  conferenceYears().map((year) => ({ params: { year: String(year) } }))) satisfies GetStaticPaths;

const year = Number(Astro.params.year);
const c = loadConference(year);
const confirmed = c.keynotes.filter((k) => !k.placeholder);
---

<ConferenceLayout
  conference={c}
  title="Keynotes"
  description={`Keynote speakers at ${c.conference.short_name}.`}
>
  <PageHeader
    title="Keynotes"
    eyebrow={c.conference.short_name}
    lede="Invited talks at this edition of ISPASS."
    breadcrumb={[{ label: c.conference.short_name, href: `/${year}/` }]}
  />

  <div class="wrap section">
    {/* Only confirmed speakers are shown. Placeholder entries would reveal how
        many talks are planned, which is often not decided yet. */}
    {confirmed.length === 0 ? (
      <aside class="callout callout-tbd">
        <b class="callout-title">Speakers not yet announced</b>
        <p>Keynote speakers will be announced here as they are confirmed.</p>
      </aside>
    ) : (
      <div class="keynotes">
        {confirmed.map((keynote, index) => (
          <KeynoteCard keynote={keynote} index={index} detail headingLevel={2} />
        ))}
      </div>
    )}
  </div>
</ConferenceLayout>

<style>
  .keynotes { display: grid; gap: var(--s-6); }
</style>
