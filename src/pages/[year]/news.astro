---
import type { GetStaticPaths } from 'astro';
import ConferenceLayout from '../../layouts/ConferenceLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Announcements from '../../components/Announcements.astro';
import { conferenceYears, loadConference } from '../../lib/conferences';

export const getStaticPaths = (() =>
  conferenceYears().map((year) => ({ params: { year: String(year) } }))) satisfies GetStaticPaths;

const year = Number(Astro.params.year);
const c = loadConference(year);
---

<ConferenceLayout
  conference={c}
  title="Announcements"
  description={`News and announcements for ${c.conference.short_name}.`}
>
  <PageHeader
    title="Announcements"
    eyebrow={c.conference.short_name}
    lede="Everything announced about this edition, newest first."
    breadcrumb={[{ label: c.conference.short_name, href: `/${year}/` }]}
  />
  <div class="wrap section">
    <Announcements conference={c} headingLevel={2} />
  </div>
</ConferenceLayout>
