---
import type { GetStaticPaths } from 'astro';
import ConferenceLayout from '../../layouts/ConferenceLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ImportantDates from '../../components/ImportantDates.astro';
import { conferenceYears, loadConference } from '../../lib/conferences';
import { formatDate } from '../../lib/dates';

export const getStaticPaths = (() =>
  conferenceYears().map((year) => ({ params: { year: String(year) } }))) satisfies GetStaticPaths;

const year = Number(Astro.params.year);
const c = loadConference(year);
const { published, items, note } = c.workshops;
---

<ConferenceLayout
  conference={c}
  title="Workshops and Tutorials"
  description={`Workshops and tutorials co-located with ${c.conference.short_name}.`}
  noindex={!published}
>
  <PageHeader
    title="Workshops and Tutorials"
    eyebrow={c.conference.short_name}
    lede={published ? 'Events co-located with the main conference.' : null}
    breadcrumb={[{ label: c.conference.short_name, href: `/${year}/` }]}
  />

  <div class="wrap section">
    {note && <p class="lede">{note}</p>}

    {!published ? (
      <>
        <aside class="callout callout-tbd">
          <b class="callout-title">Not yet selected</b>
          <p>
            Workshop and tutorial proposals for {c.conference.short_name} have not been
            selected yet. Accepted events will be listed here.
          </p>
        </aside>
        <section class="next">
          <div class="section-head"><h2>Proposing a workshop or tutorial</h2></div>
          <p>
            See the <a href={`/${year}/call-for-workshops/`}>Call for Workshops and
            Tutorials</a> for what a proposal must contain and where to send it.
          </p>
          <ImportantDates conference={c} categories={['workshop']} compact calendar={false} />
        </section>
      </>
    ) : (
      <div class="items">
        {items.map((item) => (
          <article class="ws" id={item.id}>
            <p class="eyebrow">{item.kind === 'workshop' ? 'Workshop' : 'Tutorial'}</p>
            <h2 class="ws-title">{item.title}</h2>
            <p class="ws-meta small muted">
              {item.organizers.length > 0 && <span>{item.organizers.join(', ')}</span>}
              {item.date && <span>{formatDate(item.date)}</span>}
              {item.start && <span>{item.start}{item.end ? `–${item.end}` : ''}</span>}
              {item.room && <span>{item.room}</span>}
            </p>
            {item.summary && <p class="ws-summary">{item.summary}</p>}
            {item.url && (
              <p class="small"><a href={item.url} rel="noopener">Event website ↗</a></p>
            )}
            {item.schedule.length > 0 && (
              <div class="table-scroll">
                <table>
                  <caption class="visually-hidden">Schedule for {item.title}</caption>
                  <thead>
                    <tr><th scope="col">Time</th><th scope="col">Title</th><th scope="col">Speaker</th></tr>
                  </thead>
                  <tbody>
                    {item.schedule.map((row) => (
                      <tr>
                        <td class="nowrap">{row.start}{row.end ? `–${row.end}` : ''}</td>
                        <td>{row.title}</td>
                        <td>{row.speaker ?? ''}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </article>
        ))}
      </div>
    )}
  </div>
</ConferenceLayout>

<style>
  .next { margin-top: var(--s-7); }
  .items { display: grid; gap: var(--s-6); }
  .ws {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--s-5);
    scroll-margin-top: 6rem;
  }
  .ws-title { font-size: var(--step-2); margin-top: var(--s-1); }
  .ws-meta { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); margin-top: var(--s-3); }
  .ws-summary { margin-top: var(--s-4); color: var(--ink-2); max-width: var(--measure); }
  .nowrap { white-space: nowrap; font-variant-numeric: tabular-nums; }
</style>
