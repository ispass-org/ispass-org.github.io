---
import type { GetStaticPaths } from 'astro';
import ConferenceLayout from '../../layouts/ConferenceLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SponsorGrid from '../../components/SponsorGrid.astro';
import { conferenceYears, loadConference } from '../../lib/conferences';

export const getStaticPaths = (() =>
  conferenceYears().map((year) => ({ params: { year: String(year) } }))) satisfies GetStaticPaths;

const year = Number(Astro.params.year);
const c = loadConference(year);
---

<ConferenceLayout
  conference={c}
  title="Sponsors"
  description={`Sponsors and supporting organizations of ${c.conference.short_name}.`}
>
  <PageHeader
    title="Sponsors"
    eyebrow={c.conference.short_name}
    lede={c.sponsors.intro}
    breadcrumb={[{ label: c.conference.short_name, href: `/${year}/` }]}
  />

  <div class="wrap section">
    <SponsorGrid sponsors={c.sponsors} hideEmpty={false} headingLevel={2} />

    <section class="become">
      <div class="section-head"><h2>Sponsoring ISPASS</h2></div>
      <p class="lede">
        Sponsorship funds student travel grants, keeps registration affordable, and
        supports the awards. Sponsors are recognised on this site, in the
        proceedings and at the venue.
      </p>
      <p class="become-actions">
        {c.sponsors.prospectus && (
          <a class="btn btn-primary" href={c.sponsors.prospectus} rel="noopener">
            Sponsorship prospectus <span class="ext" aria-hidden="true">↗</span>
          </a>
        )}
        <a class="btn btn-secondary" href={`/${year}/committee/`}>Contact the committee</a>
      </p>
      {c.sponsors.contact && <p class="small muted">{c.sponsors.contact}</p>}
    </section>
  </div>
</ConferenceLayout>

<style>
  .become { margin-top: var(--s-8); }
  .become-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-block: var(--s-5) var(--s-3); }
</style>
