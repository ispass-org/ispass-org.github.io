dup type /arraytype eq {
1 index get
} if
dup null eq { pop } { exch } ifelse
} if
Filter dup type /arraytype eq
{ exch get } { exch pop } ifelse
filter
dup
} for
} if
/DataSource exch def
} ifelse
currentdict
/ImageMask here not { false } if
{ sfc imagemask } { image } ifelse
counttomark
{ dup status
{ dup flushfile closefile }
{ pop }
ifelse
}
repeat
pop
}ifelse
end
} bd
